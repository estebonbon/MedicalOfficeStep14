@model MedicalOffice.Models.Appointment

@{
    ViewData["Title"] = "Update Appointment";
}

<h2>Update Appoinment for Patient: @Model.Patient.Summary</h2>
<hr />

<form asp-action="Update">
    <div class="row">
        <div class="col-md-5">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <input type="hidden" name="PatientName" value="@ViewData["PatientName"]" />
            <div class="form-group">
                <label asp-for="StartTime" class="control-label"></label>
                <input asp-for="StartTime" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EndTime" class="control-label"></label>
                <input asp-for="EndTime" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExtraFee" class="control-label"></label>
                <input asp-for="ExtraFee" class="form-control" />
                <span asp-validation-for="ExtraFee" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DoctorID" class="control-label"></label>
                <select asp-for="DoctorID" class="form-control" asp-items="ViewBag.DoctorID">
                    <option value="">Select the Doctor</option>
                </select>
                <span asp-validation-for="DoctorID" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-5">
            <div class="form-group">
                <label asp-for="AppointmentReasonID" class="control-label"></label>
                <select asp-for="AppointmentReasonID" class="form-control" asp-items="ViewBag.AppointmentReasonID">
                    <option value="">No Reason Given</option>
                </select>
                <span asp-validation-for="AppointmentReasonID" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" rows="7" cols="40" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
    </div>
</form>

<div>
    <partial name="_BackToList" />
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
